# Nano Banana API Configuration
# Get your API credentials from nano banana dashboard
NANO_BANANA_API_ENDPOINT=https://api.nanobanana.com/v1/generate
NANO_BANANA_API_KEY=your_nano_banana_api_key_here

# Optional: Custom settings
NANO_BANANA_DEFAULT_STYLE=modern
NANO_BANANA_DEFAULT_QUALITY=high
NANO_BANANA_TIMEOUT=30000

# Clerk Authentication
# Get your publishable key from https://clerk.com/dashboard
VITE_CLERK_PUBLISHABLE_KEY=pk_test_your_key_here

# Convex Backend
# Get your URL from https://dashboard.convex.dev
VITE_CONVEX_URL=https://your-project.convex.cloud