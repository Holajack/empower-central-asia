VITE_SOCIAL_LINKEDIN=""
VITE_SOCIAL_YOUTUBE=""
VITE_SOCIAL_TELEGRAM=""
# External giving page (Pure Charity / E3 Partners). Leave empty to hide donate buttons.
VITE_DONATE_URL="https://www.purecharity.com/checkout/576519?amount=150&frequency=monthly&cover_fees=true"
# Google Business review link (optional; hides the "leave a review" prompt when empty)
VITE_REVIEW_URL=""

# ─── Authentication (Clerk) — https://dashboard.clerk.com ───────────────────
# Without this key the site runs in "open" mode: all courses are accessible, no accounts.
VITE_CLERK_PUBLISHABLE_KEY=""

# ─── Community backend (Convex) — created by `npx convex dev` ───────────────
VITE_CONVEX_URL=""

# ─── Email capture ──────────────────────────────────────────────────────────
# Where forms POST learner records. Default is the bundled Netlify function.
VITE_SUBSCRIBE_ENDPOINT="/.netlify/functions/subscribe"
# Optional legacy Google Apps Script webhook (kept for compatibility).
VITE_GOOGLE_SHEET_URL=""

# ─── Analytics & search verification (injected into index.html at build) ────
VITE_GA_MEASUREMENT_ID=""
VITE_GTM_ID=""
VITE_META_PIXEL_ID=""
VITE_CLARITY_ID=""
VITE_GSC_VERIFICATION=""
VITE_BING_VERIFICATION=""

# ─── Optional CMS (Sanity) — leave empty to use the bundled content ─────────
VITE_SANITY_PROJECT_ID=""
VITE_SANITY_DATASET="production"
VITE_SANITY_API_TOKEN=""
VITE_SANITY_STUDIO_URL=""

# ─── Server-side only (Netlify → Site settings → Environment variables) ─────
# Never prefix these with VITE_ — they must not reach the browser.
ACTIVECAMPAIGN_API_URL=""
ACTIVECAMPAIGN_API_KEY=""
ACTIVECAMPAIGN_LIST_ID=""
ACTIVECAMPAIGN_LANGUAGE_FIELD=""
GOOGLE_SHEET_WEBHOOK_URL=""
CLERK_WEBHOOK_SECRET=""
ALLOWED_ORIGINS=""
