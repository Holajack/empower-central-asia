# ─── Brand (all optional; defaults live in src/lib/seo.ts) ──────────────────
VITE_SITE_NAME="Central Asia Partners"
VITE_SITE_SHORT_NAME="CAP"
VITE_ORG_NAME="Central Asia Partners"
VITE_SITE_URL="https://learn.centralasiapartners.com"
VITE_SITE_DESCRIPTION="Free financial literacy, business creation, and leadership courses in English and Russian."
VITE_SITE_DESCRIPTION_RU="Бесплатные курсы по финансовой грамотности, созданию бизнеса и лидерству на русском и английском."
VITE_CONTACT_EMAIL="hello@centralasiapartners.com"
VITE_CONTACT_PHONE=""
